{
  "name": "@bitlaab/lazyload",
  "version": "2.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight JavaScript utility for lazyload images, videos, function call, and etc.",
  "keywords": [
    "lazyload",
    "IntersectionObserver",
    "image",
    "videos",
    "function call",
    "optimize",
    "neyaznafiz"
  ],
  "homepage": "https://github.com/neyaznafiz/bitlaab-lazyload#readme",
  "bugs": {
    "url": "https://github.com/neyaznafiz/bitlaab-lazyload/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neyaznafiz/bitlaab-lazyload.git"
  },
  "license": "MIT",
  "author": "Neyaz Nafiz",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && ./node_modules/.bin/tsc && ./node_modules/.bin/esbuild dist/**/*.js --minify --outdir=dist --allow-overwrite",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
